# Anything-to-MCP Frontend Configuration
#
# LOCAL DEVELOPMENT:
# Point to the local FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# VERCEL DEPLOYMENT:
# Set VITE_API_BASE_URL="" (empty string) in the Vercel dashboard Environment Variables.
# This makes the frontend call /api/* relative to the same origin,
# which Vercel routes to the Python serverless function via vercel.json.
# VITE_API_BASE_URL=
