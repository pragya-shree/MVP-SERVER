# Anything-to-MCP Environment Configuration
# Copy this file to .env and adjust values for local development or deployment.

# Application Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Storage
# Optional path for generated server artifacts and ZIP downloads
# GENERATOR_STORAGE_DIR=storage/artifacts

# Demo Target API
# Base URL for the generated demo MCP server to communicate with
DEMO_API_BASE_URL=http://127.0.0.1:8000/demo-target
